# Python 运行时自动生成的字节码缓存
__pycache__/
*.pyc

# 项目本地虚拟环境；其中的第三方库可以通过 requirements.txt 重新安装
.venv/

# Jupyter Notebook 自动生成的临时检查点
.ipynb_checkpoints/

# 本地 API Key 配置，绝对不能提交到 Git 仓库
.streamlit/secrets.toml
.env
.env.*
!.env.example

# 本地 RAG 持久化索引，可由知识文档随时重新构建
storage/rag/*.joblib

# 单 Agent 人工确认与拒绝的本地审计数据
storage/audit/*.jsonl
storage/audit/*.sqlite3
storage/audit/*.sqlite3-wal
storage/audit/*.sqlite3-shm

# 手工创建的演示客户与训练 CSV 分离；可能包含用户输入，不提交到 Git。
storage/customers/*.sqlite3
storage/customers/*.sqlite3-wal
storage/customers/*.sqlite3-shm

# 本地简历成品与生成过程文件，不属于当前项目仓库
output/resume/
tmp/

# 本地求职、学习及软件著作权申请资料
docs/interview*
docs/INTERVIEW*
docs/resume*
docs/learning*
docs/LEARNING*
docs/upgrade_plan.md
docs/review_findings.md
软件著作权申请资料/

# 浏览器自动化产生的本地会话与截图
.playwright-cli/
